# ===== ตั้งค่าต่อเครื่อง =====
# ก่อนใช้: cp feeder.env.example feeder.env แล้วแก้ค่าด้านล่างให้ตรงเครื่อง (feeder.env ไม่ commit)
#
# เดิมอ่านผ่าน local Drive mount (DRIVE_ROOT) — แต่ launchd/cron อ่าน FileProvider mount ไม่ได้เลย
# (macOS ต้องพึ่ง active GUI session ถึง materialize ไฟล์คลาวด์ได้ ให้ FDA ยังไงก็ไม่ช่วย)
# เปลี่ยนมาใช้ Google Drive API ผ่าน Apps Script proxy แทน (ดู CTO_SETUP.md + apps_script_proxy/README.md)
PROXY_URL=https://script.google.com/macros/s/CHANGE_ME/exec
PROXY_TOKEN=CHANGE_ME

# DRIVE_ROOT เหลือไว้เป็น fallback เฉื่อยๆ เผื่อย้อนกลับไป local mount (ลบ/comment PROXY_URL ด้านบนถ้าจะใช้)
#   เครื่อง cto@      : /Users/<user>/Library/CloudStorage/GoogleDrive-cto@007metals.com/My Drive/All_on_Cloud/AutoExport
DRIVE_ROOT=/CHANGE/ME/GoogleDrive-cto@007metals.com/My Drive/All_on_Cloud/AutoExport

# ===== ปลายทาง Supabase กลาง (ไม่ต้องแก้ — anon key public โดยดีไซน์) =====
SUPABASE_URL=https://syvfdbvmwaeyokytckwb.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN5dmZkYnZtd2FleW9reXRja3diIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUxOTI3ODEsImV4cCI6MjEwMDc2ODc4MX0.I1RwZX2S1PAsj-d53oba5kxSQu0VShY4CoTMxvNmS8k
WINDOW_DAYS=45

# service_role key — ใช้เฉพาะ express_sync.py (express_bill เขียนได้เฉพาะ service role
# ตาม quote_schema.sql) ห้ามให้สคริปต์อื่นใช้ ห้าม commit (feeder.env อยู่ใน .gitignore แล้ว)
# หาได้จาก Supabase → Project Settings → API → service_role  (หรือ ~/quote-app/.env.local)
# ปล่อยว่าง = express_sync.py ข้ามเงียบ ๆ ตัวอื่นทำงานปกติ
SUPABASE_SERVICE_KEY=CHANGE_ME

# express_sync ทำงานจริงทุกกี่นาที (run_all เรียกทุกรอบ 10 นาที) — ปล่อยว่าง = 60 · 0 = ทุกรอบ
EXPRESS_EVERY_MIN=60
